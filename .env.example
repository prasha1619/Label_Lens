# LabelLens Configuration Environment Variables

PROJECT_NAME="LabelLens - AI Legal Metrology Compliance"
ENVIRONMENT=development
DEBUG=True

# Database Configuration: External Supabase PostgreSQL (Recommended) or SQLite / Local Postgres
# Format 1: Supabase Transaction Pooler (Port 6543 - Best for serverless / pooled queries)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Format 2: Supabase Session Pooler (Port 5432 - Direct connection or migrations)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Format 3: Local SQLite fallback (default when no external DB specified)
DATABASE_URL=sqlite:///./labellens.db

# Supabase Auth credentials. Registration creates entries in Authentication > Users.
# Use the publishable/anon key for sign-in, and the secret/service-role key only on the backend.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Authentication (use a strong, unique secret and COOKIE_SECURE=True in production)
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
CORS_ORIGINS=["http://localhost:5173"]

# Computer Vision / YOLO Model Path
# If custom weights are not present, system will indicate model unconfigured without faking detections.
MODEL_PATH=models/legal_label_detector.pt

# OCR Engine: "auto", "paddleocr", "easyocr", "tesseract"
OCR_ENGINE=auto

# Maximum Upload File Size in Megabytes
MAX_UPLOAD_SIZE_MB=15
PROFILE_PHOTO_MAX_SIZE_MB=3
